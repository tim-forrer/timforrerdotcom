---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionPicker from '../../components/CollectionPicker.astro';
import Lightbox from '../../components/Lightbox.astro';
import { photoCollections, getCollectionBySlug } from '../../data/photos';
import type { GetStaticPaths } from 'astro';

export async function getStaticPaths() {
  return photoCollections.map((col) => ({
    params: { collection: col.slug },
    props: { collection: col },
  }));
}

const { collection } = Astro.props;
const col = getCollectionBySlug(collection.slug);
---

<BaseLayout
  title={col?.title ?? 'Collection'}
  page="photos"
  description={`Photographs in the ${col?.title ?? 'photo'} collection by Tim Forrer.`}
>
  <section class="collection-page">
    <div class="header-bar">
      <span class="collection-label">{col?.title}</span>
      <CollectionPicker current={collection.slug} />
    </div>
    <div class="masonry reveal">
      {col?.photos.map((photo, index) => (
        <button
          class="masonry-item"
          type="button"
          data-full-src={photo.src}
          data-alt={photo.alt}
          aria-label={`Open photo: ${photo.alt}`}
        >
          <img
            src={photo.thumbSrc}
            srcset={`${photo.thumbSrc} 480w, ${photo.src} ${photo.largeWidth}w`}
            sizes="(max-width: 600px) 48vw, 32vw"
            alt=""
            width={photo.width}
            height={photo.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))}
    </div>
  </section>
  <Lightbox />
</BaseLayout>

<style>
  .collection-page {
    padding-bottom: 60px;
  }

  .header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .collection-label {
    font-family: system-ui, sans-serif;
    font-size: 14px;
    color: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .masonry {
    column-count: 3;
    column-gap: 6px;
  }

  .masonry-item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    text-align: left;
    cursor: zoom-in;
    break-inside: avoid;
    margin-bottom: 6px;
    overflow: hidden;
    background: #e0e0e0;
  }

  .masonry-item:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
