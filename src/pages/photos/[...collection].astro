---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionPicker from '../../components/CollectionPicker.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import { photoCollections, getCollectionBySlug } from '../../data/photos';
import type { GetStaticPaths } from 'astro';

export async function getStaticPaths() {
  return photoCollections.map((col) => ({
    params: { collection: col.slug },
    props: { collection: col },
  }));
}

const { collection } = Astro.props;
const col = getCollectionBySlug(collection.slug);
---

<BaseLayout title={col?.title ?? 'Collection'} page="photos">
  <section class="collection-page">
    <div class="header-bar">
      <span class="collection-label">{col?.title}</span>
      <CollectionPicker current={collection.slug} />
    </div>
    <div class="masonry reveal">
      {col?.photos.map((photo) => (
        <div class="masonry-item">
          <img src={photo.src} alt={photo.title} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .collection-page {
    padding-bottom: 60px;
  }

  .header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .collection-label {
    font-family: system-ui, sans-serif;
    font-size: 16px;
    color: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .masonry {
    column-count: 3;
    column-gap: 6px;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 6px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #e0e0e0;
  }

  .masonry-item img {
    width: 100%;
    display: block;
  }
</style>
