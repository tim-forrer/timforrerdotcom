---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedPhotos } from '../data/photos';

const featuredPhoto = getFeaturedPhotos()[0];
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-image reveal">
      <img src={featuredPhoto?.src ?? '/photos/placeholder.jpg'} alt="Featured photo" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 80px);
  }

  .hero-image {
    width: 60%;
    max-width: 480px;
    border-radius: 2px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .hero-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    display: block;
  }
</style>
