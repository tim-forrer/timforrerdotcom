---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepagePhoto } from '../data/photos';

---

<BaseLayout
  title="Home"
  description="Photography and writing by Tim Forrer."
  socialImage={homepagePhoto?.src}
>
  <section class="hero" aria-label="Featured photograph">
    <div class="hero-image">
      {homepagePhoto ? (
        <img
          src={homepagePhoto.src}
          srcset={`${homepagePhoto.thumbSrc} 480w, ${homepagePhoto.src} ${homepagePhoto.largeWidth}w`}
          sizes="(max-width: 600px) 84vw, min(80vw, 1024px)"
          alt={homepagePhoto.alt}
          width={homepagePhoto.width}
          height={homepagePhoto.height}
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <img src="/photos/placeholder.svg" alt="No featured photograph selected" />
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: var(--content-width);
    margin: 0 auto;
    padding-top: 240px;
    padding-bottom: 170px;
    box-sizing: border-box;
  }

  .hero-image {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .hero-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    max-height: calc(100vh - 410px);
    display: block;
  }

  @media (max-width: 600px) {
    .hero {
      align-items: center;
      padding-top: 70px;
      padding-bottom: 0;
    }

    .hero-image img {
      max-height: calc(100vh - 200px);
    }
  }
</style>
