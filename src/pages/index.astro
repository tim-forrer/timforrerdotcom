---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedPhotos } from '../data/photos';

const featuredPhoto = getFeaturedPhotos()[0];
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-image">
      <img src={featuredPhoto?.src ?? '/photos/placeholder.jpg'} alt="Featured photo" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: var(--content-width);
    margin: 0 auto;
    padding-top: 240px;
    padding-bottom: 170px;
    box-sizing: border-box;
  }

  .hero-image {
    border-radius: 2px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .hero-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    max-height: calc(100vh - 410px);
    display: block;
  }

  @media (max-width: 600px) {
    .hero {
      align-items: center;
      padding-top: 70px;
      padding-bottom: 0;
    }

    .hero-image img {
      max-height: calc(100vh - 200px);
    }
  }
</style>
