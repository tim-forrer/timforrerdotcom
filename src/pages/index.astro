---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedPhotos } from '../data/photos';

const featuredPhoto = getFeaturedPhotos()[0];
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-image">
      <img src={featuredPhoto?.src ?? '/photos/placeholder.jpg'} alt="Featured photo" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--content-width);
    margin: 0 auto;
  }

  .hero-image {
    border-radius: 2px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .hero-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    display: block;
  }
</style>
