---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HWPagination from '../../components/HWPagination.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { readingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('writings');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingMinutes = readingTime(post);
const handwritingPages = post.data.handwriting ?? [];
const hasHandwriting = handwritingPages.length > 0;
---

<BaseLayout title={post.data.title}>
  <article class="writing">
    {hasHandwriting && (
      <p class="sr-notice">
        This page has handwritten content. Switch to Typed view for a readable version.
      </p>
    )}

    <header class="header">
      <h1 class="title">{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
        {!hasHandwriting && (
          <>
            <span class="sep">·</span>
            <span>{readingMinutes} min read</span>
          </>
        )}
      </div>
    </header>

    <div class={`viewer${hasHandwriting ? ' has-handwriting' : ''}`}>
      {hasHandwriting && (
        <>
          <input class="view-radio" type="radio" name="view" id="view-original" checked />
          <input class="view-radio" type="radio" name="view" id="view-text" />
          <div class="view-labels">
            <label for="view-original">Handwritten</label>
            <label for="view-text">Typed</label>
          </div>
        </>
      )}

      {hasHandwriting && (
        <div class="view-pane pane-original">
          <div class="hw-container" id="hw-container">
            {handwritingPages.map((src, i) => (
              <img
                class="hw-page"
                src={src}
                alt=""
                data-page={i}
                style={{ display: i < 2 ? 'block' : 'none' }}
              />
            ))}
          </div>
          <HWPagination current={1} total={Math.ceil(handwritingPages.length / 2)} />
        </div>
      )}

      <div class="view-pane pane-text">
        <div class="text-content">
          <Content />
        </div>
        <button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top">
          <span aria-hidden="true">&uarr;</span>
        </button>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const backToTop = document.getElementById('back-to-top');
  if (backToTop) {
    const update = () => {
      if (window.scrollY > 400) {
        backToTop.classList.add('show');
      } else {
        backToTop.classList.remove('show');
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    update();
  }
</script>

{hasHandwriting && (
  <script>
    const container = document.getElementById('hw-container');
    const pagination = document.querySelector('[data-component="hw-pagination"]');

    if (container && pagination) {
      const pages = container.querySelectorAll('.hw-page');
      const totalPages = pages.length;
      const wideMq = window.matchMedia('(min-width: 1024px)');
      let anchorPage = 1;

      function render() {
        const visibleCount = wideMq.matches ? Math.min(2, totalPages - anchorPage + 1) : 1;

        pages.forEach((p, i) => {
          p.style.display = (i >= anchorPage - 1 && i < anchorPage - 1 + visibleCount) ? 'block' : 'none';
        });

        const spread = wideMq.matches ? Math.ceil(anchorPage / 2) : anchorPage;
        const total = wideMq.matches ? Math.ceil(totalPages / 2) : totalPages;

        const count = pagination.querySelector('.page-count');
        if (count) count.textContent = spread + ' / ' + total;

        const prev = pagination.querySelector('[data-action="prev"]');
        const next = pagination.querySelector('[data-action="next"]');
        if (prev) prev.disabled = spread <= 1;
        if (next) next.disabled = spread >= total;
      }

      pagination.addEventListener('page-change', ((e) => {
        const desiredSpread = e.detail.page;
        anchorPage = wideMq.matches ? (desiredSpread - 1) * 2 + 1 : desiredSpread;
        render();
      }) as EventListener);

      wideMq.addEventListener('change', render);

      // Override the server-side initial render for the current viewport.
      render();
    }
  </script>
)}

<style>
  .writing {
    margin: 0 auto;
    padding-bottom: 60px;
  }

  .sr-notice {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .header {
    margin-bottom: 16px;
  }

  .title {
    font-size: 28px;
    font-weight: 600;
    color: var(--text-title);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .meta {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 10px;
    font-family: system-ui, sans-serif;
  }

  .sep {
    margin: 0 6px;
  }

  /* Handwritten / Typed switch — pure CSS, no JavaScript. */
  .view-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .view-labels {
    display: flex;
    width: fit-content;
    margin: 0 auto 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-family: system-ui, sans-serif;
    font-size: 14px;
  }

  .view-labels label {
    padding: 6px 18px;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .view-labels label + label {
    border-left: 1px solid var(--border);
  }

  .view-labels label:hover {
    background: #f0eee8;
  }

  #view-original:checked ~ .view-labels label[for="view-original"],
  #view-text:checked ~ .view-labels label[for="view-text"] {
    background: var(--accent);
    color: #fff;
  }

  .view-radio:focus-visible ~ .view-labels {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .has-handwriting .pane-text {
    display: none;
  }

  #view-text:checked ~ .pane-text {
    display: block;
  }

  #view-text:checked ~ .pane-original {
    display: none;
  }

  .hw-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hw-page {
    max-width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 1024px) {
    .hw-container {
      flex-direction: row;
      justify-content: center;
      gap: 8px;
    }

    .hw-page {
      width: calc(50% - 4px);
    }
  }

  .text-content {
    line-height: 1.8;
    color: var(--text);
  }

  @media (max-width: 600px) {
    .text-content {
      font-size: 19px;
      line-height: 1.7;
    }
  }

  .text-content :global(h2) {
    font-size: 30px;
    margin: 28px 0 12px;
    color: var(--text-title);
  }

  .text-content :global(h3) {
    font-size: 27px;
    margin: 20px 0 8px;
    color: var(--text-title);
  }

  @media (max-width: 600px) {
    .text-content :global(h2) {
      font-size: 24px;
      margin: 22px 0 10px;
    }

    .text-content :global(h3) {
      font-size: 22px;
      margin: 18px 0 6px;
    }
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(ul),
  .text-content :global(ol) {
    margin: 0 0 16px 24px;
  }

  .text-content :global(li) {
    margin-bottom: 4px;
  }

  .text-content :global(code) {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 14px;
    background: #f0f0f0;
    padding: 2px 6px;
    border-radius: 3px;
  }

  .text-content :global(pre) {
    background: #f5f5f5;
    padding: 16px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: 16px;
  }

  .text-content :global(pre) :global(code) {
    background: none;
    padding: 0;
  }

  .text-content :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 16px;
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 16px;
  }

  .text-content :global(table) {
    border-collapse: collapse;
    margin: 8px auto 20px;
  }

  .text-content :global(thead) {
    display: none;
  }

  .text-content :global(td) {
    padding: 6px 18px;
    text-align: center;
    border: none;
  }

  @media (max-width: 600px) {
    .text-content :global(td) {
      padding: 4px 10px;
    }
  }

  .text-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 10;
  }

  .back-to-top.show {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    background: var(--accent);
    color: #fff;
  }
</style>
