---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout page="about" title="About">
  <section class="about-page">
    <div class="bio reveal">
      <p>Someone who enjoys taking photos and writing nonsense. Thinking about drawing too.</p>
      <p>All photos were generated inside my camera, and all thoughts are very much my own (for better or for worse).</p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-bottom: 60px;
  }

  .bio {
    max-width: 600px;
    margin: 0 auto 48px;
  }

  .bio p {
    color: var(--text-title);
  }

  @media (max-width: 600px) {
    .bio p {
      font-size: 19px;
      line-height: 1.7;
    }
  }

</style>
