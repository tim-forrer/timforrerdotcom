---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';

const historyEntries = [
  { title: 'Swindon', year: '1998' },
  { title: 'Reading', year: '2000' },
  { title: 'Durham', year: '2017' },
  { title: 'Tokyo', year: '2021' },
];
---

<BaseLayout page="about" title="About">
  <section class="about-page">
    <div class="bio reveal">
      <p>I'm based in the Pacific Northwest. I build things, take photos, and write about both. When I'm not at a keyboard, I'm usually hiking with a camera.</p>
    </div>

    <div class="timeline-section reveal">
      <Timeline entries={historyEntries} />
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-bottom: 60px;
  }

  .bio {
    max-width: 600px;
    margin: 0 auto 36px;
  }

  .bio p {
    color: var(--text-title);
  }

  .timeline-section {
    margin-bottom: 48px;
  }

</style>
