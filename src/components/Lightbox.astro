---
---
<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
  aria-hidden="true"
>
  <button class="lightbox-close" id="lightbox-close" aria-label="Close photo viewer">&times;</button>
  <button class="lightbox-prev" id="lightbox-prev" aria-label="Previous photo">&#8249;</button>
  <button class="lightbox-next" id="lightbox-next" aria-label="Next photo">&#8250;</button>
  <div class="lightbox-tap-left" id="lightbox-tap-left" aria-hidden="true"></div>
  <div class="lightbox-tap-right" id="lightbox-tap-right" aria-hidden="true"></div>
  <div class="lightbox-content">
    <img id="lightbox-img" src="" alt="" />
    <span class="lightbox-count" id="lightbox-count" aria-live="polite"></span>
  </div>
</div>

<style>
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.95);
    align-items: center;
    justify-content: center;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox[aria-hidden='true'] {
    display: none;
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-count {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    text-shadow: 0 1px 4px #000;
  }

  .lightbox-content img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: white;
    font-size: 32px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
    z-index: 101;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  /* Arrows: hidden by default, revealed on mouse movement (see JS below),
     fading out after a couple of seconds idle — like video player controls. */
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: white;
    font-size: 48px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.4s;
    padding: 8px 16px;
    z-index: 101;
    pointer-events: none;
  }

  .lightbox.controls-visible .lightbox-prev,
  .lightbox.controls-visible .lightbox-next {
    opacity: 0.5;
    pointer-events: auto;
  }

  .lightbox.controls-visible .lightbox-prev:hover,
  .lightbox.controls-visible .lightbox-next:hover,
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible {
    opacity: 1;
  }

  .lightbox-prev {
    left: 16px;
  }

  .lightbox-next {
    right: 16px;
  }

  /* Invisible edge tap zones: touch devices only. */
  .lightbox-tap-left,
  .lightbox-tap-right {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 33%;
    z-index: 100;
  }

  .lightbox-tap-left {
    left: 0;
  }

  .lightbox-tap-right {
    right: 0;
  }

  /* Touch devices: no arrows — swipe or tap the screen edges instead. */
  @media (hover: none) {
    .lightbox-prev,
    .lightbox-next {
      display: none;
    }

    .lightbox-tap-left,
    .lightbox-tap-right {
      display: block;
    }
  }
</style>

<script>
  interface PhotoItem {
    src: string;
    alt: string;
  }

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const count = document.getElementById('lightbox-count');
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement | null;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement | null;
  const tapLeft = document.getElementById('lightbox-tap-left');
  const tapRight = document.getElementById('lightbox-tap-right');

  if (lightbox && lightboxImg && count && closeBtn && prevBtn && nextBtn && tapLeft && tapRight) {
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('.masonry-item[data-full-src]')];
    const photos: PhotoItem[] = triggers.map((trigger) => ({
      src: trigger.dataset.fullSrc ?? '',
      alt: trigger.dataset.alt ?? '',
    }));
    let currentIndex = 0;
    let triggerElement: HTMLButtonElement | null = null;
    let previousOverflow = '';
    let controlsTimer: ReturnType<typeof setTimeout> | undefined;
    let touchStartX = 0;
    let touchStartY = 0;
    let swiped = false;

    function showControls() {
      lightbox.classList.add('controls-visible');
      clearTimeout(controlsTimer);
      controlsTimer = setTimeout(() => lightbox.classList.remove('controls-visible'), 1000);
    }

    function hideControls() {
      clearTimeout(controlsTimer);
      lightbox.classList.remove('controls-visible');
    }

    function updateImage() {
      const photo = photos[currentIndex];
      if (!photo) return;
      lightboxImg.src = photo.src;
      lightboxImg.alt = photo.alt;
      count.textContent = `${currentIndex + 1} of ${photos.length}`;
    }

    function open(index: number, trigger: HTMLButtonElement) {
      if (photos.length === 0) return;
      currentIndex = index;
      triggerElement = trigger;
      updateImage();
      lightbox.setAttribute('aria-hidden', 'false');
      lightbox.classList.add('open');
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      showControls();
      closeBtn.focus();
    }

    function close() {
      lightbox.classList.remove('open', 'controls-visible');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImg.removeAttribute('src');
      document.body.style.overflow = previousOverflow;
      clearTimeout(controlsTimer);
      triggerElement?.focus();
      triggerElement = null;
    }

    function goTo(index: number) {
      if (photos.length < 2) return;
      currentIndex = (index + photos.length) % photos.length;
      updateImage();
      showControls();
    }

    function previous() {
      goTo(currentIndex - 1);
    }

    function next() {
      goTo(currentIndex + 1);
    }

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => open(index, trigger));
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', previous);
    nextBtn.addEventListener('click', next);
    tapLeft.addEventListener('click', previous);
    tapRight.addEventListener('click', next);
    lightbox.addEventListener('mousemove', showControls);
    document.documentElement.addEventListener('mouseleave', hideControls);

    lightbox.addEventListener('touchstart', (event) => {
      if (lightbox.getAttribute('aria-hidden') === 'true') return;
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
      swiped = false;
    }, { passive: true });

    lightbox.addEventListener('touchend', (event) => {
      if (lightbox.getAttribute('aria-hidden') === 'true') return;
      const dx = event.changedTouches[0].clientX - touchStartX;
      const dy = event.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        swiped = true;
        if (dx < 0) next();
        else previous();
      }
    }, { passive: true });

    lightbox.addEventListener('click', (event) => {
      if (swiped) {
        event.stopPropagation();
        swiped = false;
        return;
      }
      if (event.target === lightbox) close();
    }, true);

    document.addEventListener('keydown', (event) => {
      if (lightbox.getAttribute('aria-hidden') === 'true') return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        previous();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        next();
      } else if (event.key === 'Tab') {
        const focusable = [...lightbox.querySelectorAll<HTMLButtonElement>('button:not(:disabled)')]
          .filter((button) => button.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
