---
export interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const links = [
  { href: '/writings', label: 'writings' },
  { href: '/photos', label: 'photos' },
  { href: '/about', label: 'about' },
];
---

<nav>
  <a href="/" class="logo"><img src="/header.png" alt="Tim Forrer" /></a>
  <div class="links">
    {links.map((link) => (
      <a
        href={link.href}
        class={currentPage === link.label ? 'active' : ''}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 14px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
    font-family: system-ui, sans-serif;
  }

  .logo {
    display: block;
    line-height: 0;
  }

  .logo img {
    display: block;
    height: 26px;
    width: auto;
    opacity: 0.45;
    transition: opacity 0.2s;
  }

  .logo:hover img,
  .logo:focus-visible img {
    opacity: 1;
  }

  .links {
    display: flex;
    gap: 20px;
  }

  .links a {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .links a:hover,
  .links a.active {
    color: var(--text);
  }
</style>