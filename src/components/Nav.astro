---
export interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const links = [
  { href: '/writings', label: 'writings' },
  { href: '/photos/featured', label: 'photos' },
  { href: '/about', label: 'about' },
];
---

<nav>
  <a href="/" class="logo">tim forrer</a>
  <div class="links">
    {links.map((link) => (
      <a
        href={link.href}
        class={currentPage === link.label ? 'active' : ''}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 14px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
    font-family: system-ui, sans-serif;
  }

  .logo {
    font-weight: bold;
    font-size: 27px;
    letter-spacing: -0.5px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .logo:hover {
    color: var(--text);
  }

  .links {
    display: flex;
    gap: 20px;
  }

  .links a {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .links a:hover,
  .links a.active {
    color: var(--text);
  }
</style>