---
export interface TimelineEntry {
  title: string;
  year?: string;
}

export interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<div class="timeline">
  <div class="label">A Brief History of Tim</div>
  <div class="entries">
    {entries.map((entry) => (
      <div class="entry">
        {entry.year && <div class="entry-year">{entry.year}</div>}
        <div class="entry-title">{entry.title}</div>
        <div class="line" />
      </div>
    ))}
  </div>
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 320px;
    margin: 0 auto;
  }

  .label {
    font-family: system-ui, sans-serif;
    font-size: 16px;
    color: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .entries {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .entry {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .entry-year {
    font-family: system-ui, sans-serif;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .entry-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-title);
  }

  .line {
    width: 2px;
    height: 24px;
    background: #e0e0e0;
    margin: 6px 0;
    border-radius: 1px;
  }
</style>
